<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Chandarkant &amp; Sharannamma — 25 Years of Togetherness</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Cinzel:wght@400;500;600&family=Great+Vibes&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<style>
:root{
  --ink:#3a2e1f;
  --soft:#7a6b50;
  --gold:#b08d3e;
  --gold-deep:#8a6a1e;
  --gold-light:#e8d28a;
  --line:#d8c9a6;
  --cream:#fbf6ea;
  --cream-2:#f3e9d2;
  --maroon:#7a1623;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;min-height:100%;overflow-x:hidden}
body{
  background:#d8c9a6;
  color:var(--ink);
  font-family:'Cormorant',serif;
  -webkit-font-smoothing:antialiased;
  display:flex;align-items:flex-start;justify-content:center;
  min-height:100vh;
}

/* ===== ambient gold dust ===== */
#dust{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.mote{
  position:absolute;border-radius:50%;
  background:radial-gradient(circle,rgba(232,210,138,.9),transparent);
  animation:floatMote var(--md,9s) var(--mdl,0s) ease-in-out infinite alternate;
}
@keyframes floatMote{
  0%{transform:translate(0,0);opacity:var(--mo,.15)}
  100%{transform:translate(var(--mx,12px),var(--my,-18px));opacity:calc(var(--mo,.15)*.4)}
}

/* ======================================================
   COVER
   ====================================================== */
#cover{
  position:fixed;inset:0;z-index:60;cursor:pointer;
  background:
    radial-gradient(ellipse 70% 50% at 50% 35%,#fbf6ea 0%,#efe3c8 55%,#e2d2ab 100%);
  display:flex;align-items:center;justify-content:center;
  overflow:hidden;
}
#cover-card{
  width:min(400px,88vw);
  text-align:center;
  position:relative;
  padding:46px 26px 40px;
}
/* ornamental double frame */
#cover-card::before{
  content:'';position:absolute;inset:0;
  border:1.5px solid var(--gold);
  box-shadow:0 0 0 5px rgba(176,141,62,.12);
}
#cover-card::after{
  content:'';position:absolute;inset:9px;
  border:1px solid rgba(176,141,62,.4);
}
.corner-fl{
  position:absolute;width:62px;height:62px;z-index:3;opacity:.92;
}
.corner-fl.tl{top:-6px;left:-6px}
.corner-fl.tr{top:-6px;right:-6px;transform:scaleX(-1)}
.corner-fl.bl{bottom:-6px;left:-6px;transform:scaleY(-1)}
.corner-fl.br{bottom:-6px;right:-6px;transform:scale(-1)}

.cv-bless{
  font-family:'Cinzel',serif;
  font-size:.54rem;letter-spacing:.34em;text-transform:uppercase;
  color:var(--soft);position:relative;z-index:2;
}
.cv-25{
  position:relative;z-index:2;
  font-family:'Cormorant',serif;font-weight:300;
  font-size:clamp(5rem,24vw,8rem);line-height:.85;
  background:linear-gradient(160deg,#8a6a1e,#d8b25a 40%,#f0d894 55%,#b08d3e 75%,#8a6a1e);
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;
  letter-spacing:-.02em;
  margin-top:8px;
}
.cv-25 sup{font-size:.2em;vertical-align:super;font-style:italic;font-family:'EB Garamond',serif}
.cv-jub{
  position:relative;z-index:2;
  font-family:'Cinzel',serif;font-weight:500;
  font-size:clamp(.7rem,3vw,.92rem);
  letter-spacing:.46em;text-transform:uppercase;
  color:var(--gold-deep);margin-top:2px;
}
.cv-anniv{
  position:relative;z-index:2;
  font-family:'Great Vibes',cursive;
  font-size:clamp(2rem,8vw,3rem);color:var(--maroon);
  margin-top:6px;line-height:1;
}
.cv-rule{position:relative;z-index:2;width:40px;height:1px;background:var(--gold);margin:22px auto}
.cv-names{
  position:relative;z-index:2;
  font-family:'EB Garamond',serif;font-style:italic;
  font-size:clamp(1.1rem,4.4vw,1.35rem);color:var(--ink);line-height:1.6;
}
.cv-cta{
  position:relative;z-index:2;margin-top:34px;
  font-family:'Cinzel',serif;font-size:.55rem;letter-spacing:.3em;text-transform:uppercase;
  color:var(--soft);display:inline-flex;align-items:center;gap:10px;
}
.cv-cta .dot{width:5px;height:5px;border-radius:50%;background:var(--gold);
  animation:breathe 2.4s ease-in-out infinite}
@keyframes breathe{0%,100%{opacity:.3;transform:scale(.8)}50%{opacity:1;transform:scale(1.2)}}

/* ======================================================
   DOCUMENT
   ====================================================== */
#doc{position:relative;z-index:1;width:min(460px,94vw);
  margin:0 auto;padding:28px 0 70px;opacity:0;pointer-events:none}
#doc.live{pointer-events:auto}

.sheet{
  position:relative;overflow:hidden;
  background:linear-gradient(180deg,var(--cream) 0%,var(--cream-2) 100%);
  box-shadow:0 1px 0 rgba(255,255,255,.7) inset,
    0 40px 90px -34px rgba(40,30,15,.5),
    0 6px 24px -10px rgba(40,30,15,.3);
}
.sheet-frame{position:absolute;inset:14px;border:1.5px solid var(--gold);pointer-events:none;z-index:5}
.sheet-frame::before{content:'';position:absolute;inset:5px;border:1px solid rgba(176,141,62,.35)}

/* floral header band */
.floral-band{position:relative;height:90px;margin:0 0 4px;z-index:6}
.floral-band svg{position:absolute;left:50%;top:14px;transform:translateX(-50%);width:200px;height:64px}

.sheet-pad{position:relative;padding:46px 38px 48px;z-index:6}
@media(max-width:440px){.sheet-pad{padding:40px 26px 40px}}

.label{font-family:'Cinzel',serif;font-size:.55rem;font-weight:400;
  letter-spacing:.34em;text-transform:uppercase;color:var(--soft);text-align:center}

.rule{display:flex;align-items:center;justify-content:center;gap:14px;margin:24px 0}
.rule::before,.rule::after{content:'';height:1px;width:56px;
  background:linear-gradient(90deg,transparent,var(--gold),transparent)}
.rule i{width:6px;height:6px;border:1px solid var(--gold);transform:rotate(45deg);display:inline-block}

.intro{text-align:center;font-family:'EB Garamond',serif;font-style:italic;
  font-size:clamp(1rem,3.6vw,1.15rem);color:var(--soft);line-height:1.85}

/* hero number */
.headline{text-align:center;margin:8px 0 0}
.headline .num{
  font-family:'Cormorant',serif;font-weight:300;
  font-size:clamp(6rem,30vw,9.5rem);line-height:.82;letter-spacing:-.03em;
  background:linear-gradient(160deg,#8a6a1e,#d8b25a 42%,#f0d894 56%,#b08d3e 78%,#8a6a1e);
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
}
.headline .num sup{font-size:.2em;vertical-align:super;font-style:italic;font-family:'EB Garamond',serif}
.headline .word{font-family:'Cinzel',serif;font-size:clamp(.7rem,3vw,.95rem);
  letter-spacing:.5em;text-transform:uppercase;color:var(--gold-deep);margin-top:6px}
.headline .anniversary{font-family:'Great Vibes',cursive;
  font-size:clamp(2rem,8vw,2.8rem);color:var(--maroon);margin-top:8px;line-height:1}

/* ===== PHOTO FRAME ===== */
.photo-wrap{position:relative;margin:30px auto 6px;width:min(300px,80%)}
.photo-frame{
  position:relative;
  border-radius:50% 50% 6px 6px / 32% 32% 6px 6px; /* arch top */
  overflow:hidden;
  border:3px solid transparent;
  background:
    linear-gradient(var(--cream),var(--cream)) padding-box,
    linear-gradient(160deg,#8a6a1e,#e8d28a 45%,#b08d3e 70%,#8a6a1e) border-box;
  box-shadow:0 18px 40px -18px rgba(40,30,15,.55),0 0 0 6px rgba(176,141,62,.1);
}
.photo-frame img{display:block;width:100%;height:auto}
/* arch inner gold hairline */
.photo-arch-line{
  position:absolute;inset:6px;
  border:1px solid rgba(232,210,138,.7);
  border-radius:50% 50% 4px 4px / 30% 30% 4px 4px;
  pointer-events:none;
}
/* corner florals on photo */
.photo-fl{position:absolute;width:64px;height:64px;z-index:3;opacity:.95}
.photo-fl.tl{top:-18px;left:-18px}
.photo-fl.tr{top:-18px;right:-18px;transform:scaleX(-1)}
.photo-fl.bl{bottom:-14px;left:-16px;transform:scaleY(-1)}
.photo-fl.br{bottom:-14px;right:-16px;transform:scale(-1)}

/* names */
.names{text-align:center;margin:14px 0 0}
.names .of{font-family:'EB Garamond',serif;font-style:italic;font-size:1rem;color:var(--soft);margin-bottom:12px}
.names .n{font-family:'Cormorant',serif;font-weight:500;
  font-size:clamp(1.5rem,6vw,2.05rem);letter-spacing:.01em;line-height:1.2;color:var(--ink)}
.names .amp{font-family:'Great Vibes',cursive;font-size:clamp(1.8rem,7vw,2.6rem);
  color:var(--gold);margin:2px 0;display:block;line-height:1}

.body-copy{text-align:center;font-family:'Cormorant',serif;font-weight:400;
  font-size:clamp(1.02rem,3.6vw,1.18rem);line-height:1.95;color:var(--ink)}
.body-copy .em{font-family:'EB Garamond',serif;font-style:italic;color:var(--soft);
  display:block;margin-top:14px;font-size:clamp(.98rem,3.4vw,1.1rem)}

/* facts */
.facts{display:grid;grid-template-columns:1fr 1fr;margin:6px 0}
.fact{text-align:center;padding:18px 10px;position:relative}
.fact + .fact::before{content:'';position:absolute;left:0;top:22%;bottom:22%;width:1px;background:var(--line)}
.fact .ft-label{font-family:'Cinzel',serif;font-size:.52rem;letter-spacing:.3em;
  text-transform:uppercase;color:var(--gold-deep);margin-bottom:8px}
.fact .ft-main{font-family:'Cormorant',serif;font-weight:500;
  font-size:clamp(1.15rem,4.5vw,1.5rem);color:var(--ink);line-height:1.2}
.fact .ft-sub{font-family:'EB Garamond',serif;font-style:italic;font-size:.92rem;color:var(--soft);margin-top:3px}

/* venue */
.venue{text-align:center;margin:6px 0}
.venue .v-name{font-family:'Cormorant',serif;font-weight:600;
  font-size:clamp(1.2rem,4.5vw,1.5rem);color:var(--ink);letter-spacing:.02em}
.venue .v-addr{font-family:'EB Garamond',serif;font-size:1rem;color:var(--soft);line-height:1.6;margin-top:6px}

/* map */
.map{margin:22px 0 4px;border:1px solid var(--gold);position:relative;background:#ddd6c8}
.map iframe{display:block;width:100%;height:200px;border:0;filter:grayscale(.3) sepia(.14) contrast(.96)}
.map-foot{text-align:center;padding:12px 0 0}
.map-link{font-family:'Cinzel',serif;font-size:.55rem;letter-spacing:.28em;text-transform:uppercase;
  color:var(--gold-deep);text-decoration:none;border-bottom:1px solid rgba(176,141,62,.6);padding-bottom:3px;
  transition:color .25s,border-color .25s}
.map-link:hover{color:var(--ink);border-color:var(--ink)}

/* signoff */
.signoff{text-align:center}
.signoff .pres{font-family:'EB Garamond',serif;font-style:italic;
  font-size:clamp(1rem,3.6vw,1.15rem);color:var(--soft);line-height:1.7}
.signoff .from{font-family:'Cinzel',serif;font-size:.54rem;letter-spacing:.34em;
  text-transform:uppercase;color:var(--gold-deep);margin:18px 0 6px}
.signoff .family{font-family:'Great Vibes',cursive;font-size:clamp(2rem,8vw,2.8rem);color:var(--maroon);line-height:1.1}

.actions{display:flex;gap:12px;justify-content:center;margin-top:30px;flex-wrap:wrap}
.btn{font-family:'Cinzel',serif;font-size:.55rem;letter-spacing:.22em;text-transform:uppercase;
  padding:14px 24px;cursor:pointer;border:1px solid var(--ink);background:transparent;color:var(--ink);
  transition:background .3s,color .3s,border-color .3s}
.btn:hover{background:var(--ink);color:var(--cream)}
.btn.ghost{border-color:var(--line);color:var(--soft)}
.btn.ghost:hover{background:transparent;border-color:var(--gold);color:var(--gold-deep)}

.footnote{text-align:center;margin-top:26px;font-family:'EB Garamond',serif;font-style:italic;
  font-size:.85rem;color:var(--soft);opacity:.75}

.reveal{opacity:0;transform:translateY(16px)}
</style>
</head>
<body>

<div id="dust"></div>

<!-- ============ COVER ============ -->
<div id="cover">
  <div id="cover-card">
    <!-- corner florals -->
    <svg class="corner-fl tl" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"></svg>
    <svg class="corner-fl tr" viewBox="0 0 64 64"></svg>
    <svg class="corner-fl bl" viewBox="0 0 64 64"></svg>
    <svg class="corner-fl br" viewBox="0 0 64 64"></svg>

    <p class="cv-bless">With the blessings of the Almighty</p>
    <div class="cv-25">25<sup>th</sup></div>
    <div class="cv-jub">Silver Jubilee</div>
    <div class="cv-anniv">Anniversary</div>
    <div class="cv-rule"></div>
    <div class="cv-names">Chandarkant &amp; Sharannamma<br>Biradar</div>
    <div class="cv-cta"><span class="dot"></span>Tap to open<span class="dot"></span></div>
  </div>
</div>

<!-- ============ DOCUMENT ============ -->
<div id="doc">
  <div class="sheet">
    <div class="sheet-frame"></div>

    <!-- floral header -->
    <div class="floral-band reveal" data-r>
      <svg viewBox="0 0 200 64" xmlns="http://www.w3.org/2000/svg" id="topfloral"></svg>
    </div>

    <div class="sheet-pad">

      <p class="label reveal" data-r>With the blessings of the Almighty &amp; our loved ones</p>
      <div class="rule reveal" data-r><i></i></div>
      <p class="intro reveal" data-r>we joyfully invite you to celebrate<br>the joyous occasion of our</p>

      <div class="headline reveal" data-r>
        <div class="num">25<sup>th</sup></div>
        <div class="word">Silver Jubilee</div>
        <div class="anniversary">Wedding Anniversary</div>
      </div>

      <!-- PHOTO -->
      <div class="photo-wrap reveal" data-r>
        <div class="photo-frame">
          <img id="couple-photo" alt="Chandarkant & Sharannamma Biradar">
          <div class="photo-arch-line"></div>
        </div>
        <svg class="photo-fl tl" viewBox="0 0 64 64"></svg>
        <svg class="photo-fl tr" viewBox="0 0 64 64"></svg>
        <svg class="photo-fl bl" viewBox="0 0 64 64"></svg>
        <svg class="photo-fl br" viewBox="0 0 64 64"></svg>
      </div>

      <div class="names reveal" data-r>
        <p class="of">in loving celebration of</p>
        <div class="n">Mr. Chandarkant Biradar</div>
        <span class="amp">and</span>
        <div class="n">Mrs. Sharannamma Biradar</div>
      </div>

      <div class="rule reveal" data-r><i></i></div>

      <p class="body-copy reveal" data-r>
        Twenty-five years of togetherness, of love,<br>
        of beautiful memories — and a lifetime of happiness.
        <span class="em">Please join us as we celebrate this milestone<br>
        with your presence, blessings and best wishes.</span>
      </p>

      <div class="rule reveal" data-r><i></i></div>

      <div class="facts reveal" data-r>
        <div class="fact">
          <div class="ft-label">Date</div>
          <div class="ft-main">Friday, 5 June</div>
          <div class="ft-sub">2026</div>
        </div>
        <div class="fact">
          <div class="ft-label">Time</div>
          <div class="ft-main">6:30 in the evening</div>
          <div class="ft-sub">onwards</div>
        </div>
      </div>

      <div class="rule reveal" data-r><i></i></div>

      <div class="venue reveal" data-r>
        <div class="label" style="margin-bottom:12px">The Venue</div>
        <div class="v-name">N20 Restaurant</div>
        <div class="v-addr">Dhanvantari Hospital Lane<br>Ram Mandir Circle, Kalaburagi, Karnataka</div>
      </div>

      <div class="map reveal" data-r>
        <iframe loading="lazy" referrerpolicy="no-referrer-when-downgrade"
          src="https://maps.google.com/maps?q=Ram%20Mandir%20Circle%2C%20Kalaburagi%2C%20Karnataka&t=&z=15&ie=UTF8&iwloc=&output=embed"></iframe>
        <div class="map-foot">
          <a class="map-link" target="_blank"
            href="https://maps.google.com/?q=N20+Restaurant+Ram+Mandir+Circle+Kalaburagi+Karnataka">Get Directions</a>
        </div>
      </div>

      <div class="rule reveal" data-r><i></i></div>

      <div class="signoff reveal" data-r>
        <p class="pres">Your presence will make<br>our celebration even more special.</p>
        <p class="from">With warm regards</p>
        <div class="family">The Biradar Family</div>
        <div class="actions">
          <button class="btn" onclick="addToCalendar()">Add to Calendar</button>
          <button class="btn ghost" onclick="share()">Share</button>
        </div>
      </div>

      <p class="footnote reveal" data-r>Kalaburagi · Karnataka · MMXXVI</p>
    </div>
  </div>
</div>

<script>
/* ===== floral SVG (reused for corners + header) ===== */
const cornerSVG = `
<g fill="none" stroke="#b08d3e" stroke-width="1.1" opacity="0.95">
  <path d="M4 4 C18 8 26 16 30 30" stroke-width="1.4"/>
  <path d="M4 4 C12 18 18 24 30 30" opacity=".6"/>
  <ellipse cx="14" cy="12" rx="4" ry="2.2" fill="#e8d28a" stroke="#b08d3e" stroke-width=".7" transform="rotate(40 14 12)"/>
  <ellipse cx="22" cy="20" rx="4.5" ry="2.4" fill="#d8b25a" stroke="#b08d3e" stroke-width=".7" transform="rotate(40 22 20)"/>
  <ellipse cx="9" cy="20" rx="3.4" ry="1.9" fill="#f0d894" stroke="#b08d3e" stroke-width=".6" transform="rotate(-25 9 20)"/>
  <circle cx="29" cy="9" r="3.2" fill="#f7efd6" stroke="#b08d3e" stroke-width=".7"/>
  <circle cx="29" cy="9" r="1" fill="#b08d3e"/>
</g>`;
document.querySelectorAll('.corner-fl,.photo-fl').forEach(s=>s.innerHTML=cornerSVG);

/* header floral spray */
document.getElementById('topfloral').innerHTML = `
<g fill="none" stroke="#b08d3e" stroke-width="1.1">
  <path d="M100 60 C70 50 55 30 40 12" />
  <path d="M100 60 C130 50 145 30 160 12" />
  <path d="M100 60 C92 40 92 24 96 8" opacity=".55"/>
  <path d="M100 60 C108 40 108 24 104 8" opacity=".55"/>
  <ellipse cx="52" cy="22" rx="6" ry="3.2" fill="#e8d28a" stroke="#b08d3e" stroke-width=".7" transform="rotate(35 52 22)"/>
  <ellipse cx="70" cy="34" rx="6" ry="3.2" fill="#d8b25a" stroke="#b08d3e" stroke-width=".7" transform="rotate(35 70 34)"/>
  <ellipse cx="148" cy="22" rx="6" ry="3.2" fill="#e8d28a" stroke="#b08d3e" stroke-width=".7" transform="rotate(-35 148 22)"/>
  <ellipse cx="130" cy="34" rx="6" ry="3.2" fill="#d8b25a" stroke="#b08d3e" stroke-width=".7" transform="rotate(-35 130 34)"/>
  <circle cx="100" cy="6" r="5" fill="#f7efd6" stroke="#b08d3e" stroke-width=".8"/>
  <circle cx="100" cy="6" r="1.6" fill="#b08d3e"/>
  <circle cx="40" cy="10" r="4" fill="#f7efd6" stroke="#b08d3e" stroke-width=".7"/>
  <circle cx="160" cy="10" r="4" fill="#f7efd6" stroke="#b08d3e" stroke-width=".7"/>
</g>`;

/* ===== gold dust ===== */
(function(){
  const d=document.getElementById('dust');
  for(let i=0;i<40;i++){
    const m=document.createElement('div');m.className='mote';
    const s=2+Math.random()*5;
    m.style.cssText=`width:${s}px;height:${s}px;left:${Math.random()*100}%;top:${Math.random()*100}%;
      --md:${6+Math.random()*8}s;--mdl:${Math.random()*6}s;
      --mx:${(Math.random()-.5)*40}px;--my:${(Math.random()-.5)*40}px;--mo:${.08+Math.random()*.18};`;
    d.appendChild(m);
  }
})();

/* ===== inject couple photo (base64) ===== */
const PHOTO_B64 = "";
document.getElementById('couple-photo').src = "data:image/jpeg;base64,"+PHOTO_B64;

/* ===== cover entrance ===== */
window.addEventListener('load',()=>{
  gsap.set('#cover-card',{opacity:0,y:18});
  gsap.to('#cover-card',{opacity:1,y:0,duration:1.2,ease:'power3.out',delay:.2});
  gsap.from('.cv-25',{scale:.7,opacity:0,duration:1,ease:'back.out(1.5)',delay:.45});
  gsap.from('.corner-fl',{opacity:0,scale:.5,duration:.9,stagger:.1,delay:.6,ease:'power2.out'});
});

/* ===== open ===== */
let opened=false;
document.getElementById('cover').addEventListener('click',openDoc);
function openDoc(){
  if(opened)return;opened=true;
  const cover=document.getElementById('cover'),doc=document.getElementById('doc');
  gsap.to('#cover-card',{y:-26,opacity:0,duration:.7,ease:'power2.in'});
  gsap.to(cover,{opacity:0,duration:.8,delay:.35,ease:'power2.inOut',onComplete:()=>cover.style.display='none'});
  doc.classList.add('live');
  gsap.to(doc,{opacity:1,duration:.6,delay:.5});
  gsap.from('.sheet',{y:44,duration:1,ease:'power3.out',delay:.5});
  gsap.to('[data-r]',{opacity:1,y:0,duration:.7,ease:'power2.out',stagger:.07,delay:.65});
}

/* ===== calendar ICS ===== */
function addToCalendar(){
  const ics=['BEGIN:VCALENDAR','VERSION:2.0','PRODID:-//Biradar//Anniversary//EN','BEGIN:VEVENT',
    'DTSTART:20260605T130000Z','DTEND:20260605T173000Z',
    'SUMMARY:25th Silver Jubilee — Chandarkant & Sharannamma Biradar',
    'LOCATION:N20 Restaurant, Ram Mandir Circle, Kalaburagi, Karnataka',
    'DESCRIPTION:Please join us to celebrate 25 years of togetherness.',
    'END:VEVENT','END:VCALENDAR'].join('\r\n');
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([ics],{type:'text/calendar'}));
  a.download='Biradar-Silver-Jubilee.ics';a.click();
}
/* ===== share ===== */
function share(){
  const txt='You are invited to the 25th Silver Jubilee Anniversary of Mr. Chandarkant & Mrs. Sharannamma Biradar — Friday, 5 June 2026, 6:30 PM, N20 Restaurant, Kalaburagi.';
  if(navigator.share){navigator.share({title:'Silver Jubilee Invitation',text:txt}).catch(()=>{});}
  else{navigator.clipboard&&navigator.clipboard.writeText(txt);alert('Invitation details copied!');}
}
</script>
</body>
</html>
